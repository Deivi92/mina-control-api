# ============================================================
# MinaControl Pro - Variables de Entorno de Ejemplo
#
# Instrucciones:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores con tus datos reales
#   3. NUNCA subas el archivo .env al repositorio
# ============================================================

# --- Base de Datos PostgreSQL ---
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Seguridad JWT ---
# Genera una clave segura con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- Expiración de Tokens (en milisegundos) ---
# 900000   ms = 15 minutos  (Access Token)
# 604800000 ms = 7 días     (Refresh Token)
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
